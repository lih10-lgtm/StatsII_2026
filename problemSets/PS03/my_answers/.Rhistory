# Problem 2
#####################
# load data
mexico_elections <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/MexicoMuniData.csv")
# load essential libraries
library(nnet)
library(MASS)
library(dplyr)
library(stargazer)
# load data
mexico_elections <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/MexicoMuniData.csv")
# run poisson regression model
poi_ml <- glm(PAN.visits.06 ~ competitive.district + marginality.06 + PAN.governor.06,
data = mexico_elections, family = poisson)
# show coefficients, standard errors, and z-values
summary(poi_ml)
# calculate Rate Ratios (RR) by exponentiating the coefficients
exp(cbind(RR = coef(poi_ml) , confint(poi_ml)))
# generate LaTeX table
stargazer(poi_ml, type = "latex", apply.coef = exp,
title = "Poisson Regression (Rate Ratios)",
out = "poisson_table.tex")
# check equal variance assumption
dispersiontest (poi_ml)
# run poisson regression model
poi_ml <- glm(PAN.visits.06 ~ competitive.district + marginality.06 + PAN.governor.06,
data = mexico_elections, family = poisson)
# show coefficients, standard errors, and z-values
summary(poi_ml)
# calculate Odds Ratios (OR) / Rate Ratios (RR) by exponentiating the coefficients
exp(cbind(OR = coef(poi_ml) , confint(poi_ml)))
# generate LaTeX table
stargazer(poi_ml, type = "latex", apply.coef = exp,
title = "Poisson Regression (Rate Ratios)",
out = "poisson_table.tex")
# check equal variance assumption (over-dispersion)
dispersiontest(poi_ml)
library(nnet)
library(MASS)
library(dplyr)
library(stargazer)
library(AER)
dispersiontest(poi_ml)
# use fake data and generate predicted expected counts
pred_data <- data.frame(competitive.district = 1, marginality.06 = 0, PAN.governor.06 = 1)
pred_count <- predict(poi_ml, newdata = pred_data, type = "response")
cbind(pred_data, Predicted_Visits = pred_count)
