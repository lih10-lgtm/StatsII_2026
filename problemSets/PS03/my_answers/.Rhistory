# load esseential libraries
library(nnet)
library(MASS)
library(dplyr)
library(stargazer)
# load data
gdp_data <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/gdpChange.csv", stringsAsFactors = F)
gdp_clean <- gdp_data |>
select(GDPWdiff, REG, OIL) |>
filter(!is.na(GDPWdiff) & !is.na(REG) & !is.na(OIL)) |>
mutate(
GDPWdiff_t = case_when(
GDPWdiff > 0 ~ "positive",
GDPWdiff < 0 ~ "negative",
TRUE ~ "no change"
),
GDPWdiff_unord = relevel(as.factor(GDPWdiff_t), ref = "negative"),
GDPWdiff_ord = factor(GDPWdiff_t,
levels = c("negative", "no change", "positive"),
ordered = TRUE)
)
head(gdp_clean)
# 1.1 construct an unordered multinomial logit model
unord_ml <- multinom(GDPWdiff_unord ~ REG + OIL, data = gdp_clean)
# show coefficients
coef(unord_ml)
# calculate OR by exponentiating the coefficients
exp(coef(unord_model))
# clean data
gdp_clean <- gdp_data |>
select(GDPWdiff, REG, OIL) |>
filter(!is.na(GDPWdiff) & !is.na(REG) & !is.na(OIL)) |>
mutate(
GDPWdiff_t = case_when(
GDPWdiff > 0 ~ "positive",
GDPWdiff < 0 ~ "negative",
TRUE ~ "no change"
),
GDPWdiff_unord = relevel(as.factor(GDPWdiff_t), ref = "negative"),
GDPWdiff_ord = factor(GDPWdiff_t,
levels = c("negative", "no change", "positive"),
ordered = TRUE)
)
head(gdp_clean)
# 1.1 construct an unordered multinomial logit model
unord_ml <- multinom(GDPWdiff_unord ~ REG + OIL, data = gdp_clean)
# show coefficients
coef(unord_ml)
# calculate OR by exponentiating the coefficients
exp(coef(unord_ml))
stargazer(unord_ml, type = "latex", apply.coef = exp,
title = "Unordered Multinomial Logit (Odds Ratios)",
out = "unordered_table.tex")
# load data
gdp_data <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/gdpChange.csv", stringsAsFactors = F)
# clean data
gdp_clean <- gdp_data |>
select(GDPWdiff, REG, OIL) |>
filter(!is.na(GDPWdiff) & !is.na(REG) & !is.na(OIL)) |>
mutate(
GDPWdiff_t = case_when(
GDPWdiff > 0 ~ "positive",
GDPWdiff < 0 ~ "negative",
TRUE ~ "no change"
),
GDPWdiff_unord = relevel(as.factor(GDPWdiff_t), ref = "no change"),
GDPWdiff_ord = factor(GDPWdiff_t,
levels = c("negative", "no change", "positive"),
ordered = TRUE)
)
head(gdp_clean)
# 1.1 construct an unordered multinomial logit model
unord_ml <- multinom(GDPWdiff_unord ~ REG + OIL, data = gdp_clean)
# show raw coefficients
coef(unord_ml)
# calculate OR by exponentiating the coefficients
exp(coef(unord_ml))
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 1), OIL = c(0, 0))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_probsd)
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 1), OIL = c(0, 0))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_prob)
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 1), OIL = c(0, 0))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_probs)
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 1), OIL = c(1, 0))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_probs)
# generate LaTeX table
stargazer(unord_ml, type = "latex", apply.coef = exp,
title = "Unordered Multinomial Logit (Odds Ratios)",
out = "unordered_table.tex")
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 0), OIL = c(1, 0))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_probs)
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 1), OIL = c(0, 0))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_probs)
# create fake data to show predicted probability
fake_data <- data.frame(REG = c(0, 1, 0, 0), OIL = c(0, 0, 0,1))
pred_probs <- predict(unord_ml, newdata = fake_data, type = "probs")
cbind(fake_data, pred_probs)
# 1.2 construct an ordered multinomial logit model
# Remember to set Hess = TRUE to get standard errors and p-values
ord_ml <- polr(GDPWdiff_ord ~ REG + OIL, data = gdp_clean, Hess = TRUE)
# show coefficients, standard errors, and cutoffs
summary(ord_ml)
# extract the estimated cutoff points
ord_ml$zeta
# calculate Odds Ratios (OR) by exponentiating the coefficients
exp(coef(ord_ml))
# generate LaTeX table
stargazer(ord_ml, type = "latex", apply.coef = exp,
title = "Ordered Logit (Odds Ratios)",
out = "ordered_table.tex")
# calculate Odds Ratios (OR) by exponentiating the coefficients
exp(cbind(OR = coef(ord_ml) , confint (ord_ml)))
# 计算 REG 从 0 变成 1 的概率变化 (控制 OIL = 0)
dc(ord_ml, values1 = c(REG = 0, OIL = 0), values2 = c(REG = 1, OIL = 0))
# use fake data and generate predicted probabilities
fake_data_ord <- data.frame(REG = c(0, 1, 0, 0), OIL = c(0, 0, 0, 1))
pred_probs_ord <- predict(ord_ml, newdata = fake_data_ord, type = "probs")
cbind(fake_data_ord, pred_probs_ord)
# use fake data and generate predicted probabilities
fake_data_ord <- data.frame(REG = c(0, 1, 0, 0), OIL = c(0, 0, 0, 1))
pred_probs_ord <- predict(ord_ml, newdata = fake_data_ord, type = "probs")
cbind(fake_data_ord, pred_probs_ord)
# calculate probability changes
diff_REG <- pred_probs_ord[2, ] - pred_probs_ord[1, ]
diff_OIL <- pred_probs_ord[4, ] - pred_probs_ord[3, ]
rbind("Effect of REG (0 to 1)" = diff_REG,
"Effect of OIL (0 to 1)" = diff_OIL)
#####################
# load libraries
# set wd
# clear global .envir
#####################
# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# here is where you load any necessary packages
# ex: stringr
# lapply(c("stringr"),  pkgTest)
lapply(c("nnet", "MASS"),  pkgTest)
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
